# Copy this file to `.env` and fill in the values.
# Ask a web team lead for access to the shared credentials.

# --- Supabase (required) -----------------------------------------------------
# Auth, the `user` table, and file storage. Without these the app will not boot.
NEXT_PUBLIC_SUPABASE_URL="SUPABASE URL HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE ANON KEY HERE"

# --- Google Drive (required for resume upload) -------------------------------
# Service account used by /api/drive_upload. GOOGLE_PRIVATE_KEY keeps its
# literal \n escapes — paste it exactly as it appears in the JSON key file.
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_auth_uri="https://accounts.google.com/o/oauth2/auth"
GOOGLE_token_uri="https://oauth2.googleapis.com/token"
GOOGLE_auth_provider_x509_cert_url="https://www.googleapis.com/oauth2/v1/certs"
GOOGLE_client_x509_cert_url=
GOOGLE_universe_domain="googleapis.com"

# Destination folder for uploaded resumes.
GOOGLE_DRIVE_FOLDER_ID=

# --- Umami analytics (required for the /admin dashboard) ---------------------
# Without these, /admin renders but its traffic charts return an error.
UMAMI_API_ENDPOINT=
UMAMI_API_KEY=

# --- Google Maps (required for the existing EigenAI page) --------------------
# /eigenai renders dynamically; the existing page throws at request time if unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Vercel Flags (optional locally) -----------------------------------------
# Feature flags (e.g. Eigen-AI-Redesign) evaluate on the server via the Flags
# SDK (`flags/next` + `@vercel/flags-core`). FLAGS contains the current
# environment's SDK key (vf_server_...) or flags: connection string. Use the
# Development key locally and Preview key on preview. Missing FLAGS selects
# fixtures locally and off in production builds. VERCEL_ENV=production always
# stays off, even with credentials or an authenticated Explorer override.
FLAGS=
# Independent encryption key for Flags Explorer discovery and browser overrides.
# Generate a distinct value for each environment: 32 random bytes, base64url.
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# This is NOT a Vercel Flags SDK key. Without it, provider evaluation still works.
FLAGS_SECRET=
#
# Keeps a build-time snapshot of flag definitions out of the bundle, so a
# provider outage can't fall back to it (which could re-enable a flag). Leave set to 1.
VERCEL_FLAGS_DISABLE_DEFINITION_EMBEDDING=1

# --- Site (optional locally) -------------------------------------------------
# Absolute origin used for Supabase auth redirects. The default is fine for
# local development; production sets this to the deployed URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payload CMS ------------------------------------------------------------
# Server-only secret used to sign Payload authentication tokens. Generate a
# unique value for each environment, for example with `openssl rand -base64 32`.
PAYLOAD_SECRET=

# Local Postgres service started by `npm run payload:db:start`. These are
# development-only credentials from compose.payload.yml, not Supabase secrets.
# Payload owns only the `payload` schema inside this local database.
PAYLOAD_DATABASE_URI="postgresql://payload:payload_local_dev@127.0.0.1:5432/utmist_payload"
